{
  "compilerOptions": {
    // Output: modern JS for browsers, with DOM types for Blob, canvas and WebGL.
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    // ESM with explicit .js import paths, matching "type": "module".
    // Output written this way works in Node and in every bundler.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    // src/*.ts compiles to dist/*.js, with .d.ts files so users get the types.
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
