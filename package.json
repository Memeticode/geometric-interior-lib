{
  "name": "@memeticode/geometric-interior",
  "version": "0.1.0",
  "description": "Geometric interior image generation",
  "keywords": [
    "generative-art",
    "webgl",
    "three",
    "procedural",
    "art",
    "geometry",
    "portrait",
    "self-portrait"
  ],
  "homepage": "https://github.com/Memeticode/geometric-interior-lib#readme",
  "bugs": {
    "url": "https://github.com/Memeticode/geometric-interior-lib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Memeticode/geometric-interior-lib.git"
  },
  "license": "MIT",
  "author": "Memeticode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/three": "^0.172.0",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "^0.172.0"
  }
}
